generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model User {
  id                     Int       @id @default(autoincrement())
  login                  String    @unique
  passwordHash           String
  salt                   String
  name                   String
  role                   Int
  banned                 Boolean   @default(false)
  refreshToken           String?
  refreshTokenExpiryTime DateTime?
  organization           String    @default("")
  representativeContacts String    @default("")
  avatarSeed             String?
  avatarUrl              String?
  sessions               UserSession[]
  events                 Event[]

  @@map("Users")
}

model Event {
  id           Int      @id @default(autoincrement())
  userId       Int
  client       String
  reason       String
  creationTime DateTime
  status       Int
  startTime    DateTime
  endTime      DateTime
  warningsJson String
  comment      String?
  adminComment String?
  searchText   String?
  detailsJson  String?
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("Events")
}

model UserSession {
  id               String   @id @default(uuid())
  userId           Int
  refreshTokenHash String   @unique
  createdAt        DateTime @default(now())
  lastUsedAt       DateTime @default(now())
  expiresAt        DateTime
  revokedAt        DateTime?
  userAgent        String?
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, revokedAt])
}

model AuthRateLimit {
  key String @id
  count Int
  resetsAt DateTime
}
